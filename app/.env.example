# 数据库
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_comic_drama?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google OAuth（可选）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI 模型 API Keys（根据需要配置）
# 说明：正常路径下每个用户在「设置 → AI 模型」里配自己的 key（AES-256 加密存库），
# 这里这些进程级 key 只是平台兜底/本地开发用，生产可全部留空。
DEEPSEEK_API_KEY=""
# DeepSeek 自定义网关地址；留空默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# 图像生成
RUNWAY_API_KEY=""
LUMA_API_KEY=""
REPLICATE_API_TOKEN=""
# Fal.ai：由 @fal-ai SDK 自行读取此变量（代码里不显式读），
# 用户级 fal 配置走 UserAIConfig，此处仅平台兜底
FAL_KEY=""

# 语音合成
ELEVENLABS_API_KEY=""
# 火山引擎 TTS（变量名须与代码一致，否则 TTS 静默失效）
VOLC_APP_ID=""
VOLC_ACCESS_TOKEN=""

# 对象存储（Cloudflare R2）
# 注意：代码读 R2_ENDPOINT（不是 R2_ACCOUNT_ID）。未配 R2 时自动降级本地盘
# （见下方 LOCAL_STORAGE_*）
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# 本地存储降级（未配 R2 时生效；产物落 public/uploads）
USE_LOCAL_STORAGE=""
LOCAL_STORAGE_DIR="public/uploads"
LOCAL_STORAGE_URL_PREFIX="/uploads"

# 站点 URL（支付回调 / 绝对链接拼接用）
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 平台兜底 AI 配置：新用户未配自有 key 时回落到此用户的配置（留空则不兜底）
PLATFORM_FALLBACK_USER_ID=""

# 内网 AI 中转站直连白名单（SSRF 校验豁免，逗号分隔的 origin）
# 场景：中转站与本应用同宿主机时，走公网域名会绕 Cloudflare，套上其 100 秒
# origin 超时硬顶（error 524），长文本生成必被截断。填此变量后可把 AI 配置的
# baseUrl 直接指向 127.0.0.1，绕开公网往返。
# 安全：仅豁免此处显式列出的 origin（精确匹配协议+主机+端口）；用户在前端填写的
# 内网地址仍会被 lib/url-guard.ts 拦截，二者信任级别不同。
INTERNAL_API_ALLOWLIST=""

# 日志级别（debug/info/warn/error，默认 info）
LOG_LEVEL="info"

# 导出转场（xfade）开关
ENABLE_VIDEO_XFADE=""

# Redis（Stage 2 生产强烈建议必填）
# - 不设置 → InMemoryQueue（任务进程崩溃即丢）+ MemoryStore 限流（多实例不同步）+ 事件不跨进程
# - 设置 → BullMQ 持久化队列 + RedisStore 分布式限流 + Redis PubSub 跨实例事件广播
REDIS_URL="redis://localhost:6379"

# 可观测性（Stage 2.9）- Langfuse
# - 未配置 → observeLLM/recordGeneration 变 no-op，不影响功能
# - 配置 → chatCompletion/generateImage/generateVideo 自动打 trace
# 注册 https://cloud.langfuse.com 拿到密钥，或自托管
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# 自托管才需要填；默认 cloud.langfuse.com
LANGFUSE_BASE_URL=""
# 批量刷新阈值（生产环境调到 10-20 减少 HTTP 开销；开发 1 便于看实时数据）
LANGFUSE_FLUSH_AT="1"

# Prompt 缓存 TTL（秒；Stage 2.7）— 默认 7 天
# 适当调大可进一步降低成本；prompt 含有高度动态成分则调小避免占用 Redis
PROMPT_CACHE_TTL="604800"

# Admin 邮箱白名单（Stage 3.6）—— 可访问 /admin/metrics
# 逗号分隔；未设置则所有 admin 端点返回 404
ADMIN_EMAILS=""

# 定时清理密钥 —— 供无 session 的外部定时器调用 POST /api/admin/cleanup
# （请求头 x-cron-secret 与此值常量时间比对）。未设置则只有 admin session 能调。
# 生成：openssl rand -hex 32
CRON_SECRET=""

# 生成并发上限（同时在途的 AI 生成请求数；默认 8）
# 所有生成同步跑在 web 进程里，调太高会打满内存/上游配额
GENERATION_MAX_CONCURRENCY="8"

# PostgreSQL 连接池上限（默认 20）
# 单进程部署下不必调；多实例时各实例之和不要超过 PG 的 max_connections
PG_POOL_MAX="20"

# 内容安全审核（可选）
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
# 阿里云内容安全接入点；留空默认 green.cn-shanghai.aliyuncs.com
ALIYUN_CONTENT_SAFETY_ENDPOINT=""
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""

# 支付（可选）—— 变量名须与代码一致，否则回调验签/下单静默失效
# 微信支付 v3
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_KEY=""
WECHAT_CERT_SERIAL=""
WECHAT_PRIVATE_KEY=""
WECHAT_PLATFORM_PUBLIC_KEY=""
WECHAT_NOTIFY_URL=""
# 支付宝
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL=""
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 加密密钥（用于 API Key 加密存储）
ENCRYPTION_KEY="your-32-byte-encryption-key-generate-with-openssl-rand-hex-32"

# 部署版本（可选）—— GET /api/health 的 commit 字段
# 常规部署不用填：deploy.sh 会把短 SHA 写进 app/.git-commit，代码优先读环境
# 变量、其次读该文件（见 src/lib/env.ts 的 getRuntimeEnv）。仅在不走 deploy.sh
# 的部署方式（容器镜像等）里显式注入。
GIT_COMMIT=""

# 注：NODE_ENV 不在此声明 —— 由 Next.js 自己按命令决定
# （next dev → development，next build/start → production），手工覆盖会引发
# 构建产物与运行时不一致。
