# 数据库
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_comic_drama?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google OAuth（可选）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI 模型 API Keys（根据需要配置）
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# 图像生成
RUNWAY_API_KEY=""
LUMA_API_KEY=""
REPLICATE_API_TOKEN=""

# 语音合成
ELEVENLABS_API_KEY=""
# 火山引擎 TTS（变量名须与代码一致，否则 TTS 静默失效）
VOLC_APP_ID=""
VOLC_ACCESS_TOKEN=""

# 对象存储（Cloudflare R2）
# 注意：代码读 R2_ENDPOINT（不是 R2_ACCOUNT_ID）。未配 R2 时自动降级本地盘
# （见下方 LOCAL_STORAGE_*）
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# 本地存储降级（未配 R2 时生效；产物落 public/uploads）
USE_LOCAL_STORAGE=""
LOCAL_STORAGE_DIR="public/uploads"
LOCAL_STORAGE_URL_PREFIX="/uploads"

# 站点 URL（支付回调 / 绝对链接拼接用）
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 平台兜底 AI 配置：新用户未配自有 key 时回落到此用户的配置（留空则不兜底）
PLATFORM_FALLBACK_USER_ID=""

# 日志级别（debug/info/warn/error，默认 info）
LOG_LEVEL="info"

# 导出转场（xfade）开关
ENABLE_VIDEO_XFADE=""

# Redis（Stage 2 生产强烈建议必填）
# - 不设置 → InMemoryQueue（任务进程崩溃即丢）+ MemoryStore 限流（多实例不同步）+ 事件不跨进程
# - 设置 → BullMQ 持久化队列 + RedisStore 分布式限流 + Redis PubSub 跨实例事件广播
REDIS_URL="redis://localhost:6379"

# 可观测性（Stage 2.9）- Langfuse
# - 未配置 → observeLLM/recordGeneration 变 no-op，不影响功能
# - 配置 → chatCompletion/generateImage/generateVideo 自动打 trace
# 注册 https://cloud.langfuse.com 拿到密钥，或自托管
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# 自托管才需要填；默认 cloud.langfuse.com
LANGFUSE_BASE_URL=""
# 批量刷新阈值（生产环境调到 10-20 减少 HTTP 开销；开发 1 便于看实时数据）
LANGFUSE_FLUSH_AT="1"

# Prompt 缓存 TTL（秒；Stage 2.7）— 默认 7 天
# 适当调大可进一步降低成本；prompt 含有高度动态成分则调小避免占用 Redis
PROMPT_CACHE_TTL="604800"

# Admin 邮箱白名单（Stage 3.6）—— 可访问 /admin/metrics
# 逗号分隔；未设置则所有 admin 端点返回 404
ADMIN_EMAILS=""

# 内容安全审核（可选）
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
TENCENT_SECRET_ID=""
TENCENT_SECRET_KEY=""

# 支付（可选）—— 变量名须与代码一致，否则回调验签/下单静默失效
# 微信支付 v3
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_KEY=""
WECHAT_CERT_SERIAL=""
WECHAT_PRIVATE_KEY=""
WECHAT_PLATFORM_PUBLIC_KEY=""
WECHAT_NOTIFY_URL=""
# 支付宝
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL=""
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 加密密钥（用于 API Key 加密存储）
ENCRYPTION_KEY="your-32-byte-encryption-key-generate-with-openssl-rand-hex-32"
