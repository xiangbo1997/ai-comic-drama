generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 用户表
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String? // 密码哈希（邮箱登录）
  name          String?
  image         String?
  emailVerified DateTime?
  credits       Int       @default(300) // 初始积分（覆盖一次含一致性的完整 5 镜创作，保障首次成功体验）
  inviteCode    String    @unique @default(cuid()) // 用户专属邀请码
  invitedBy     String? // 邀请人ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  projects             Project[]
  series               Series[] // 漫剧系列（多集容器）
  characters           Character[]
  tags                 Tag[] // 用户自定义标签
  checkins             Checkin[]
  invitations          Invitation[]              @relation("Inviter") // 我邀请的人
  orders               Order[]
  subscriptions        Subscription[]
  aiConfigs            UserAIConfig[]
  generationPreference UserGenerationPreference?
  customProviders      AIProvider[] // 用户自定义的 AI 提供商
  workflowRuns         WorkflowRun[]
  creditTransactions   CreditTransaction[] // 积分流水
}

// 积分流水表（统一积分服务的审计账本）
// 每次积分变动都写一条记录，并保存变动后余额快照便于审计与对账
model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  delta        Int // 积分变动：正=增加 负=扣减
  balanceAfter Int // 变动后余额快照（审计用）
  type         String // 业务类型：GENERATE_IMAGE/GENERATE_VIDEO/GENERATE_TTS/GENERATE_REFERENCE/PAYMENT/SUBSCRIPTION/REFUND/CHECKIN/INVITE
  source       String? // 业务来源（模块/场景标识）
  sourceId     String? // 关联ID（taskId/orderNo 等），用于幂等去重
  note         String? // 备注
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 幂等约束只作用于「需要幂等」的类型（REFUND/PAYMENT/SUBSCRIPTION/
  // CHECKIN/INVITE）——这些同一 sourceId 只该有一条流水。GENERATE_* 扣费
  // 每次都合法产生新流水（且历史上 sourceId 未必唯一），不能纳入约束。
  // Prisma schema 无法声明带 WHERE 的部分唯一索引，故用 SQL 手建（见下方
  // 迁移 SQL 注释 / prisma/sql/*）。此处仅保留普通索引。
  @@index([userId, createdAt])
  @@index([sourceId])
}

// 签到记录
model Checkin {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date // 签到日期
  credits   Int      @default(5) // 获得积分
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// NextAuth 账户
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth 会话
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 验证令牌
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 项目/作品
// 系列（漫剧多集容器）：世界观/主角/风格等系列级设定挂在这里，
// 每一集是一个 Project（seriesId + episodeNumber）。角色一致性依旧走
// 用户级角色库（Character），系列不重复建模；新建一集时复制上一集的
// ProjectCharacter 关联即可延续角色阵容。
model Series {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  worldview   String?  @db.Text // 系列世界观（新集短剧脚本预填）
  protagonist String?  @db.Text // 主角设定（新集短剧脚本预填）
  genre       String? // 类型：都市/玄幻/悬疑…
  style       String   @default("anime") // 系列统一画风，新集继承
  aspectRatio String   @default("9:16") // 系列统一画幅，新集继承
  // 系列故事圣经——跨集永久记忆，由史官 LLM 每集收官后增量更新。
  // 结构见 types/series-bible.ts#SeriesStoryBible；默认 "{}" 对老系列完全兼容。
  storyBible  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects Project[]

  @@index([userId])
}

model Project {
  id               String        @id @default(cuid())
  title            String
  description      String?
  status           ProjectStatus @default(DRAFT)
  inputText        String?       @db.Text // 原始输入文本
  style            String        @default("anime") // 风格: anime, realistic, etc.
  aspectRatio      String        @default("9:16") // 比例
  // Stage 1.9：生成参数（用户可调），结构参考 types/project.ts#GenerationParams
  // 默认 {} 对老项目完全兼容；字段缺失则回落到各 Agent 内部硬编码
  generationParams Json          @default("{}")
  // 平台竖屏封面（红果/抖音审核链条覆盖封面）：已有分镜/定妆图做底 + 中文大字
  // 标题的确定性合成产物（零 AI 成本，走 services/cover.ts）。为空时导出封面/
  // 列表卡缩略图回落首张有图分镜（渐进增强，老项目零回归）。
  coverImageUrl    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 所属系列（可空=独立项目）。删系列 SetNull：各集降级为独立项目，不销毁内容
  seriesId      String?
  series        Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  episodeNumber Int? // 集数（1 起）；仅在 seriesId 非空时有意义

  scenes            Scene[]
  characters        ProjectCharacter[]
  workflowRuns      WorkflowRun[]
  shortDramaScripts ShortDramaScript[]
  locations         ProjectLocation[]

  @@index([userId]) // 项目列表页按 userId 查询，无此索引则全表扫描
  @@index([seriesId, episodeNumber]) // 系列分组/上下集导航按此查询
}

// 场景锚图（地点空景板，计划 §5 · 2.2）：以 locationKey 为业务键，为同一物理地点
// 沉淀一张「无人物环境板」+ 环境描述，作为该地点所有分镜出图的场景锚（锁背景/布局/光线）。
// 刻意不在 Scene 上加 locationId 外键：分镜已带 locationKey（解析层产出），
// 再加一个外键会有「两处地点标识」不一致的风险；此表用 locationKey 关联，单一真源。
model ProjectLocation {
  id          String   @id @default(cuid())
  projectId   String
  locationKey String // 与 Scene.locationKey 对齐的地点短标签
  description String?  // 地点环境描述（LLM 汇总，可用户改）
  imageUrl    String?  // 空景锚图（无人物环境板）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locationKey])
  @@index([projectId])
}

// 短剧创作脚本：承载「世界观→结构化脚本」+「九宫格分镜表」+「一键九宫格图」
// 与 Scene（一镜一图的执行单元）解耦，作为可反复打磨的创作态草稿
model ShortDramaScript {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 结构化脚本元信息（创作者可打磨）
  filmTitle   String? // 片名
  genre       String? // 类型
  durationSec Int     @default(90) // 时长（秒）
  aspectRatio String  @default("9:16") // 画幅
  style       String  @default("anime") // 风格
  protagonist String? @db.Text // 主角身份
  worldview   String? @db.Text // 世界观

  scriptDoc    Json    @default("{}") // 阶段1：结构化脚本主体（分场景）
  storyboard   Json? // 阶段2：九宫格分镜表 9 格
  gridImageUrl String? // 阶段3：一键九宫格合成图 URL

  version   Int      @default(1) // 打磨版本号
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
}

// 分镜/场景
model Scene {
  id          String  @id @default(cuid())
  order       Int // 顺序
  shotType    String? // 景别: 特写/中景/远景
  description String  @db.Text // 画面描述
  dialogue    String? @db.Text // 对话
  narration   String? @db.Text // 旁白
  emotion     String? // 情感
  duration    Int     @default(3) // 预估时长(秒)
  ttsSpeed    Float   @default(1.1) // 配音语速（0.5–2.0，TTS provider 消费；1.1=漫剧快节奏默认）

  // 尾帧衔接下一镜：生成本镜视频时把下一镜图片作为尾帧（Veo FL 首尾帧插值），
  // 适合空间连续的相邻镜头；下一镜未出图时生成端自动回落普通 I2V
  videoLinkNext Boolean @default(false)

  // 镜头语言（LLM 脚本解析产出，喂给出图 prompt 增强电影感）
  cameraAngle    String? // 镜头角度: eye-level/high-angle/low-angle/dutch-angle...
  lighting       String? // 光线: soft natural daylight/harsh rim light...
  composition    String? // 构图: rule of thirds/centered symmetry...
  colorPalette   String? // 色调: warm orange & teal/desaturated muted tones...
  cameraMovement String? // 运镜（喂给视频模型）: zoom_in/pan_left/tilt_up/static...
  actionBeat     String? @db.Text // 运动节拍——这一镜内"什么在动"，LLM 解析产出，喂视频 prompt

  // 叙事节拍（批4 冲击表现力）：LLM 解析产出
  beatType String? // 节拍类型: impact(打击)/reveal(揭秘)/emotional(情绪)/calm(平静)——驱动默认冲击效果与视频动作强度
  isClimax Boolean @default(false) // 高潮镜标记（每集1-2镜）：出图夸张表情升climax档、生成侧豁免裁剪

  // 地点标签：同一物理地点的分镜共用同一短标签，供场景锚定图（环境一致性）分组，
  // 让同一地点的多个分镜背景/空间布局不漂移；LLM 解析产出。
  // 不加索引：所有查询都带 projectId（走 @@index([projectId, order]) 已足够）。
  locationKey String?

  // 分镜级换装标注 [{name:角色名, outfit:服装短语}]，LLM 解析产出，
  // 仅剧情明确非默认着装（婚纱/战损/雨夜湿透/睡衣等）时出现；日常/默认着装省略。
  // 出图时据此按角色换成场景定妆照（换装变体），锁服装正确性。
  characterOutfits Json?

  // 生成结果
  imageUrl String? // 生成的图片URL
  videoUrl String? // 生成的视频URL
  audioUrl String? // 生成的音频URL

  // 生成状态
  imageStatus GenerationStatus @default(PENDING)
  videoStatus GenerationStatus @default(PENDING)
  audioStatus GenerationStatus @default(PENDING)

  // 角色一致性：用户选择用于图像生成的角色
  selectedCharacterId  String? // 选择的角色ID（从场景的多个角色中选择一个用于图像生成）- 向后兼容
  selectedCharacter    Character? @relation("SceneSelectedCharacter", fields: [selectedCharacterId], references: [id], onDelete: SetNull)
  selectedCharacterIds String[]   @default([]) // 多选角色ID数组（用于多角色场景）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sceneCharacters SceneCharacter[]

  // 迭代式图片生成：该分镜的历次生成版本（用于版本对比/切换回退）
  generationAttempts GenerationAttempt[] @relation("SceneAttempts")

  // 分镜恒按 project 查询并按 order 排序（列表/导出/批量保存回读）
  @@index([projectId, order])
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// 角色
model Character {
  id            String  @id @default(cuid())
  name          String
  gender        String?
  age           String?
  description   String? @db.Text // 外貌描述（自由文本，向后兼容）
  voiceId       String? // TTS 音色ID
  voiceProvider String? // TTS 服务商

  // 参考图（向后兼容，新数据同步写入 referenceAssets）
  referenceImages String[] // 参考图URL数组

  // 角色定妆锚点：三视图的正面定妆图。后续所有分镜出图以它作 i2i 参考 +
  // Face Validator 以它为校验基准，是角色跨分镜一致性的「身份锚」。
  canonicalImageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects        ProjectCharacter[]
  scenes          SceneCharacter[]
  asSelectedIn    Scene[]                   @relation("SceneSelectedCharacter")
  tags            CharacterTag[]
  appearance      CharacterAppearance?
  referenceAssets CharacterReferenceAsset[]
  faceEmbeddings  CharacterFaceEmbedding[]
  looks           CharacterLook[]

  @@index([userId]) // 角色库页按 userId 查询，无此索引则全表扫描
}

// 角色结构化外貌
model CharacterAppearance {
  id          String    @id @default(cuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  hairStyle       String?
  hairColor       String?
  faceShape       String?
  eyeColor        String?
  bodyType        String?
  height          String?
  skinTone        String?
  clothingPresets Json? // [{name, description, imageRef?}]
  accessories     String?
  freeText        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 角色参考资产
model CharacterReferenceAsset {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  url          String
  sourceType   String  @default("upload") // upload | ai_generated | canonical
  isCanonical  Boolean @default(false)
  pose         String? // front | side | back | 3quarter
  qualityScore Float?
  mimeType     String?
  width        Int?
  height       Int?

  createdAt DateTime @default(now())

  @@index([characterId])
}

// 角色换装定妆照缓存
// 剧情换装（婚纱/战损/雨夜湿透/睡衣等）时，以角色定妆锚 canonicalImageUrl 为参考
// 编辑式衍生出「同一角色穿指定服装」的场景定妆照，按 outfitKey 缓存复用，
// 保证同角色同套衣服跨分镜只生成一次、且形象一致。
model CharacterLook {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  outfitKey  String // 服装规整键（outfit trim 后规整），@@unique 去重用
  outfitDesc String  @db.Text // 原始服装描述（进出图 prompt 的服装短语）
  imageUrl   String? // 衍生出的换装定妆照 URL；生成失败时为空

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([characterId, outfitKey])
  @@index([characterId])
}

// 角色人脸 Embedding
model CharacterFaceEmbedding {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  embedding     Float[] // 512-dim ArcFace vector
  modelVersion  String
  sourceAssetId String?

  createdAt DateTime @default(now())

  @@index([characterId])
}

// 角色标签
model Tag {
  id       String  @id @default(cuid())
  name     String // 标签名称
  category String? // 分类：style(风格)/gender(性别)/role(角色类型)/other
  color    String? // 标签颜色（十六进制）
  order    Int     @default(0) // 排序
  isSystem Boolean @default(false) // 是否为系统预设标签

  userId String? // 用户自定义标签的所属用户
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  characters CharacterTag[]

  createdAt DateTime @default(now())

  @@unique([name, isSystem]) // 系统标签名唯一
  @@index([userId])
}

// 角色-标签关联
model CharacterTag {
  characterId String
  tagId       String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([characterId, tagId])
}

// 项目-角色关联
model ProjectCharacter {
  id          String @id @default(cuid())
  projectId   String
  characterId String

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([projectId, characterId])
  // 反向查询"角色被哪些项目引用"（如删角色前的引用检查）；复合唯一索引的
  // 最左前缀是 projectId，无法服务 WHERE characterId=? 的查询
  @@index([characterId])
}

// 场景-角色关联
model SceneCharacter {
  id          String  @id @default(cuid())
  sceneId     String
  characterId String
  dialogue    String? @db.Text // 该角色在此场景的台词

  scene     Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
  // 反向查询"角色出现在哪些场景"；同 ProjectCharacter，最左前缀是 sceneId
  @@index([characterId])
}

// 生成任务队列
model GenerationTask {
  id     String           @id @default(cuid())
  type   TaskType
  status GenerationStatus @default(PENDING)
  input  Json // 输入参数
  output Json? // 输出结果
  error  String? // 错误信息
  cost   Int              @default(0) // 消耗积分（整数；原 Float 易产生浮点脏数据）

  // 关联
  projectId String?
  sceneId   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  attempts GenerationAttempt[]

  // 按项目回查任务（导出状态/历史）；按 status+createdAt 扫僵尸任务
  @@index([projectId])
  @@index([status, createdAt])
}

// 生成尝试记录
model GenerationAttempt {
  id     String         @id @default(cuid())
  taskId String
  task   GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  attemptNumber     Int
  provider          String
  model             String
  strategy          String // prompt_only | reference_edit | face_id
  seed              Int?
  referenceAssetIds String[]

  // 验证结果
  similarityScores Json?
  faceCount        Int?
  passedValidation Boolean?
  failureReason    String?

  outputUrl String?
  createdAt DateTime @default(now())

  // 迭代式图片生成：直接关联分镜，供「按分镜列所有历史版本」单表查询
  sceneId   String?
  scene     Scene?  @relation("SceneAttempts", fields: [sceneId], references: [id], onDelete: Cascade)
  // 本次迭代用户输入的追加指令（"改成夜晚"），null=常规生成/首版
  note      String? @db.Text
  // 是否为该分镜当前选中版本（切换回退时维护；当前版本真相仍是 Scene.imageUrl）
  isCurrent Boolean @default(false)

  @@index([taskId])
  // 按分镜列历史版本，最新在前
  @@index([sceneId, createdAt])
}

enum TaskType {
  SCRIPT_PARSE // 剧本拆解
  IMAGE_GENERATE // 图像生成
  VIDEO_GENERATE // 视频生成
  AUDIO_GENERATE // 音频生成
  EXPORT // 导出
}

// 邀请记录
model Invitation {
  id           String           @id @default(cuid())
  inviterId    String // 邀请人ID
  inviteeId    String // 被邀请人ID
  inviteeEmail String // 被邀请人邮箱
  credits      Int              @default(50) // 奖励积分
  status       InvitationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  completedAt  DateTime? // 完成时间（被邀请人注册时）

  inviter User @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([inviterId, inviteeEmail])
}

enum InvitationStatus {
  PENDING // 待注册
  COMPLETED // 已完成
  EXPIRED // 已过期
}

// 订单表
model Order {
  id          String      @id @default(cuid())
  orderNo     String      @unique // 订单号
  userId      String
  type        OrderType // 订单类型
  productId   String // 商品ID（积分包ID或订阅计划ID）
  productName String // 商品名称
  amount      Decimal     @db.Decimal(10, 2) // 支付金额（元），两位小数精度
  credits     Int // 获得积分
  status      OrderStatus @default(PENDING)

  // 支付信息
  paymentMethod PaymentMethod? // 支付方式
  paymentId     String? // 支付流水号
  paidAt        DateTime? // 支付时间

  // 订阅相关
  subscriptionId String? // 订阅ID
  expiresAt      DateTime? // 订阅到期时间

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([orderNo])
}

enum OrderType {
  CREDITS // 积分包
  SUBSCRIPTION // 订阅
}

enum OrderStatus {
  PENDING // 待支付
  PAID // 已支付
  CANCELLED // 已取消
  REFUNDED // 已退款
  EXPIRED // 已过期
}

enum PaymentMethod {
  WECHAT // 微信支付
  ALIPAY // 支付宝
  STRIPE // Stripe（国际）
}

// 订阅表
model Subscription {
  id       String             @id @default(cuid())
  userId   String
  planId   String // 订阅计划ID
  planName String // 计划名称
  status   SubscriptionStatus @default(ACTIVE)

  // 周期信息
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  // 积分发放
  creditsPerPeriod Int // 每周期积分
  lastCreditAt     DateTime? // 上次发放时间

  // 取消信息
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE // 活跃
  CANCELLED // 已取消
  EXPIRED // 已过期
  PAST_DUE // 逾期
}

// ============ AI 模型管理 ============

// AI 服务提供商（系统预置 + 用户自定义）
model AIProvider {
  id           String     @id @default(cuid())
  name         String // 显示名称
  slug         String     @unique // 唯一标识
  category     AICategory // 分类
  description  String? // 描述
  baseUrl      String? // API 基础 URL
  apiProtocol  String? // 默认 API 协议（openai, claude, gemini 等）
  models       Json // 支持的模型列表 [{id, name, description, costPerUnit}]
  configSchema Json? // 配置项 schema（用于前端动态表单）
  isActive     Boolean    @default(true)
  sortOrder    Int        @default(0)
  isCustom     Boolean    @default(false) // 是否为用户自定义提供商
  userId       String? // 自定义提供商的所属用户（null 表示系统预置）
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userConfigs UserAIConfig[]

  @@index([userId])
}

enum AICategory {
  LLM // 大语言模型
  IMAGE // 图像生成
  VIDEO // 视频生成
  TTS // 语音合成
}

// 用户 AI 配置
model UserAIConfig {
  id             String      @id @default(cuid())
  userId         String
  providerId     String
  apiKey         String // AES-256 加密后的 API Key
  apiKeyIv       String // 加密 IV
  customBaseUrl  String? // 自定义中转节点 URL（覆盖提供商默认 baseUrl）
  apiProtocol    String? // API 协议类型（openai, claude, gemini 等），null 表示使用提供商默认协议
  customModels   Json? // 用户自定义模型列表 [{id, name, protocol?}]
  extraConfig    Json? // 额外配置（如 App ID、Secret 等）
  selectedModel  String? // 当前选择的模型 ID
  authType       AuthType    @default(API_KEY) // 认证方式
  tokenExpiresAt DateTime? // token 过期时间（ChatGPT token 等有时效的凭证）
  isEnabled      Boolean     @default(true)
  isDefault      Boolean     @default(false) // 是否为该分类的默认
  lastTestedAt   DateTime? // 上次测试时间
  testStatus     TestStatus? // 测试状态
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([userId])
}

enum TestStatus {
  SUCCESS
  FAILED
  PENDING
}

// 认证方式
enum AuthType {
  API_KEY // 标准 API Key（默认）
  CHATGPT_TOKEN // ChatGPT access_token + 自部署代理
  OAUTH // OAuth 认证（预留）
}

// 用户生成偏好设置
model UserGenerationPreference {
  id              String          @id @default(cuid())
  userId          String          @unique
  defaultLLM      String? // 默认 LLM 配置 ID
  defaultImage    String? // 默认图像配置 ID
  defaultVideo    String? // 默认视频配置 ID
  defaultTTS      String? // 默认 TTS 配置 ID
  concurrencyMode ConcurrencyMode @default(PARALLEL)
  maxConcurrent   Int             @default(3) // 最大并发数
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ConcurrencyMode {
  SERIAL // 串行
  PARALLEL // 并行
}

// ============ Agent Workflow ============

// Workflow 运行记录
model WorkflowRun {
  id          String         @id @default(cuid())
  projectId   String
  userId      String
  status      WorkflowStatus @default(PENDING)
  currentStep String?
  config      Json // WorkflowConfig
  artifacts   Json           @default("{}") // Artifact 引用
  error       String?        @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps   WorkflowStepRun[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

// Workflow 步骤执行记录
model WorkflowStepRun {
  id            String    @id @default(cuid())
  workflowRunId String
  step          String // WorkflowStep enum value
  agentName     String
  status        String    @default("pending")
  input         Json?
  output        Json?
  reasoning     String?   @db.Text // Agent 推理过程
  attempts      Int       @default(0)
  tokensUsed    Int       @default(0)
  error         String?   @db.Text
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([step])
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}
